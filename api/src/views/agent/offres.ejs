<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Offres en attente de validation - JobConnect Agent</title>
  <link rel="stylesheet" href="/css/agent.css">
</head>
<body>

  <header class="agent-header">
    <nav class="agent-nav">
      <a href="/agent/offres" class="brand-title">JobConnect</a>
      <ul class="nav-menu">
        <li><a href="/agent/offres" class="nav-link active">Offres en attente</a></li>
        <li><a href="/agent/categories" class="nav-link">Catégories</a></li>
      </ul>
      <div class="agent-profile">
        <span>Agent Modérateur</span>
        <span class="badge-agent">Agent</span>
      </div>
    </nav>
  </header>

  <main class="main-container">

    <div class="page-header">
      <h1 class="page-title">Offres en attente de validation</h1>
      <p class="page-subtitle">Annonces postées par les entreprises en attente de vérification avant publication.</p>
    </div>

    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success">
        <%= success %>
      </div>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error">
        <%= error %>
      </div>
    <% } %>

    <% if (!offres || offres.length === 0) { %>
      <div class="empty-box">
        <h2 class="empty-title">Aucune offre en attente</h2>
        <p>Toutes les annonces déposées ont été traitées.</p>
      </div>
    <% } else { %>
      <div class="offers-table-wrapper">
        <table class="offers-table">
          <thead><tr><th scope="col">Titre de l'offre</th><th scope="col">Entreprise</th><th scope="col">Catégorie</th><th scope="col">Date de soumission</th><th scope="col">Action</th></tr></thead>
          <tbody>
            <% offres.forEach(function(offre) { %>
              <tr>
                <td><%= offre.titre %></td>
                <td><%= offre.entreprise ? offre.entreprise.nomEntreprise : 'Entreprise' %></td>
                <td><%= offre.categorie ? offre.categorie.libelle : 'Général' %></td>
                <td><%= offre.dateSoumission ? new Date(offre.dateSoumission).toLocaleDateString('fr-FR') : 'Non précisée' %></td>
                <td>
                  <details class="offer-review">
                    <summary>Examiner <span class="visually-hidden"><%= offre.titre %></span></summary>
                    <div class="offer-review-details">
                      <p><strong>Description :</strong> <%= offre.description %></p>
                      <% if (offre.lieu || offre.localisation) { %><p><strong>Lieu :</strong> <%= offre.lieu || offre.localisation %></p><% } %>
                      <% if (offre.typeContrat) { %><p><strong>Contrat :</strong> <%= offre.typeContrat %></p><% } %>
                      <p><strong>Salaire :</strong> <%= offre.salaire != null ? offre.salaire.toLocaleString('fr-FR') + ' €/an' : 'Non précisé' %></p>
                      <% if (offre.missionsPrincipales) { %><p><strong>Missions principales :</strong> <%= offre.missionsPrincipales %></p><% } %>
                      <% if (offre.profilRecherche || offre.exigencesCandidat) { %><p><strong>Profil recherché :</strong> <%= offre.profilRecherche || offre.exigencesCandidat %></p><% } %>
                      <button type="button" class="btn-reject" onclick="openRejectModal('<%= offre._id %>')">Refuser</button>
                    </div>
                  </details>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>

  </main>

  <div id="reject-modal" class="modal-overlay">
    <div class="modal-card">
      <div class="modal-header">
        <h2 class="modal-title">Motif du refus de l'offre</h2>
        <p class="modal-subtitle">Veuillez indiquer clairement les raisons du refus afin que l'entreprise puisse corriger son annonce.</p>
      </div>
      <form id="reject-form" method="POST" action="">
        <div class="form-group">
          <label for="motifRefus" class="form-label">Motif du refus <span class="required-star">*</span></label>
          <textarea id="motifRefus" name="motifRefus" class="form-textarea" rows="4" required placeholder="La description du poste manque de précisions concernant la rémunération exacte et les horaires de travail en mode hybride."></textarea>
        </div>
        <div class="modal-actions">
          <button type="button" class="btn-cancel" onclick="closeRejectModal()">Annuler</button>
          <button type="submit" class="btn-confirm-reject">Confirmer le refus</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function openRejectModal(id) {
      var modal = document.getElementById('reject-modal');
      var form = document.getElementById('reject-form');
      var textarea = document.getElementById('motifRefus');
      form.action = '/agent/offres/' + id + '/reject';
      textarea.value = '';
      modal.classList.add('active');
    }
    function closeRejectModal() {
      var modal = document.getElementById('reject-modal');
      modal.classList.remove('active');
    }
  </script>

</body>
</html>
